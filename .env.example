# Copy to .env.local for running on your computer. On Vercel, add the same two names under Project Settings > Environment Variables.
# Both values are public by design (they ship to the browser). NEVER put the service_role key or the database password here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
